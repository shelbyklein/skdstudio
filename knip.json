{
	"$schema": "https://unpkg.com/knip@5/schema.json",
	"workspaces": {
		".": {
			"entry": ["scripts/**/*.{ts,mjs,cjs}"],
			"project": "scripts/**/*.{ts,mjs,cjs}"
		},
		"apps/studio": {
			"entry": [
				"src/index.ts",
				"src/preload.ts",
				"src/migrations/index.ts",
				"src/additional-phrases.ts",
				"forge.config.ts",
				"electron.vite.config.ts",
				"e2e/global-setup.ts",
				"e2e/**/*.test.ts"
			],
			"project": "{src,e2e}/**/*.{ts,tsx}"
		},
		"apps/cli": {
			"entry": [
				"index.ts",
				"php-server-child.ts",
				"playground-server-child.ts",
				"process-manager-daemon.ts",
				"proxy-daemon.ts",
				"logger.ts",
				"commands/**/*.ts",
				"vite.config.*.ts"
			],
			"project": "**/*.ts"
		},
		"packages/common": {
			"entry": ["translations/index.ts"],
			"project": "**/*.ts"
		},
		"tools/eslint-plugin-studio": {
			"project": "**/*.{js,ts}"
		}
	},
	"ignoreDependencies": ["@wp-playground/cli"]
}
